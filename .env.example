SENTINEL_ENV=local
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=true

# Database — defaults to local SQLite. Override for Postgres.
SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
# SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel

# Anomaly model
SENTINEL_MODEL_PATH=models/anomaly.onnx
SENTINEL_ANOMALY_THRESHOLD=-0.15

# Scanner
SENTINEL_SCAN_INTERVAL_SECONDS=300
SENTINEL_DPD_WARNING_DAYS=30
SENTINEL_DPD_DEFAULT_DAYS=90

# Observability
SENTINEL_METRICS_ENABLED=true
SENTINEL_TRACING_OTLP_ENDPOINT=

# CORS — comma-separated origins
SENTINEL_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
